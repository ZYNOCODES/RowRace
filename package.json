{
  "name": "rowrace3d",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "app",
    "shared",
    "simulator"
  ],
  "scripts": {
    "start": "npm --workspace app run start --",
    "start:go": "npm --workspace app run start:go --",
    "app": "npm --workspace app run start",
    "app:android": "npm --workspace app run android",
    "sim": "npm --workspace simulator run start",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "sim:dry": "npm --workspace simulator run start -- --dry-run",
    "preview:scene": "rm -rf tools/scene-preview/characters && cp -r app/assets/characters tools/scene-preview/characters && esbuild tools/scene-preview/main.js --bundle --format=esm --outfile=tools/scene-preview/dist/preview.js && echo 'open http://localhost:8765/?map=alpine&char=erika' && python3 -m http.server 8765 --directory tools/scene-preview",
    "characters": "node tools/characters/convert.mjs",
    "characters:thumbs": "node tools/characters/thumbs.mjs",
    "characters:publish": "node tools/characters/publish.mjs",
    "brand": "node tools/brand/make-icons.mjs",
    "apk": "npm --workspace app run build:apk"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.14",
    "@eslint/js": "^9.39.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "babel-jest": "^29.7.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fbx2gltf": "^0.9.7-p1",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
