{
  "name": "rowrace3d",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "app",
    "shared",
    "simulator"
  ],
  "scripts": {
    "start": "npm --workspace app run start --",
    "start:go": "npm --workspace app run start:go --",
    "app": "npm --workspace app run start",
    "app:android": "npm --workspace app run android",
    "sim": "npm --workspace simulator run start",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "sim:dry": "npm --workspace simulator run start -- --dry-run"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.14",
    "@eslint/js": "^9.39.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
